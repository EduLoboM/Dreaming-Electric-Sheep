[flake8]
ignore = E203, E266, W503, E704, E701, F824, C901, E501
max-line-length = 88
max-complexity = 18
per-file-ignores =
    dreaming_electric_sheep/__init__.py:F401
    dreaming_electric_sheep/client/__init__.py:F401
    dreaming_electric_sheep/server/__init__.py:F401
    dreaming_electric_sheep/url.py:E501
    tests/*:E501,F401,F841,F632,E402,F811
    itests/*:E501,F401,F841
    itests/conftest.py:F401,F403

exclude =
    .venv
    env
    .env
    venv
    venv311
    build
    .eggs
